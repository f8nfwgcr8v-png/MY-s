#labels{position:fixed;inset:0;pointer-events:none;overflow:hidden}
.lab{position:absolute;left:0;top:0;padding:4px 10px;border-radius:999px;font-size:12.5px;font-weight:500;white-space:nowrap;
  background:var(--panel);color:var(--ink);border:1px solid var(--line);opacity:0;transition:opacity .35s;will-change:transform}
.top{position:fixed;top:0;left:0;right:0;padding:calc(12px + env(safe-area-inset-top,0px)) 14px 0;display:flex;justify-content:space-between;align-items:flex-start;gap:10px;pointer-events:none}
.brand{pointer-events:auto;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:8px 14px;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
.brand b{display:block;font-family:'Playfair Display',Georgia,serif;font-size:24px;letter-spacing:.5px;color:var(--gold);line-height:1.1;direction:ltr;text-align:right}
.brand span{font-size:12.5px;color:var(--ink2)}
.ibtn{pointer-events:auto;width:42px;height:42px;border-radius:50%;border:1px solid var(--line);background:var(--panel);color:var(--gold);
  font:800 18px 'Tajawal',sans-serif;cursor:pointer;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
#card{position:fixed;left:14px;right:14px;top:calc(76px + env(safe-area-inset-top,0px));max-width:340px;margin-inline-start:0;
  background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:14px 16px;font-size:14px;line-height:1.7;
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);transform-origin:top right;transition:opacity .25s,transform .25s}
#card[hidden]{display:block;opacity:0;transform:scale(.96);pointer-events:none}
#card h2{margin:0 0 4px;font-size:16px;color:var(--gold)}
#card .row{display:flex;gap:8px;color:var(--ink2)}
#card .row b{color:var(--ink);font-weight:500;min-width:54px}
#card a.go{display:block;margin-top:10px;text-align:center;padding:10px;border-radius:10px;background:var(--gold);color:#17120a;font-weight:800;text-decoration:none}
#card a.tel{color:var(--gold);text-decoration:none;direction:ltr;unicode-bidi:embed}
#card small{display:block;margin-top:8px;color:var(--ink2);font-size:11.5px}
.hint{position:fixed;left:0;right:0;bottom:calc(86px + env(safe-area-inset-bottom,0px));text-align:center;font-size:12.5px;color:var(--ink);pointer-events:none;transition:opacity .8s}
.hint span{display:inline-block;padding:5px 12px;border-radius:999px;background:var(--panel);border:1px solid var(--line)}
.dock{position:fixed;left:0;right:0;bottom:0;display:flex;justify-content:center;padding:0 10px calc(14px + env(safe-area-inset-bottom,0px));pointer-events:none}
.dock .bar{pointer-events:auto;display:flex;gap:4px;padding:5px;border-radius:18px;background:var(--panel);border:1px solid var(--line);
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);max-width:100%}
.dock button{font:500 14px 'Tajawal',sans-serif;color:var(--ink);background:transparent;border:0;border-radius:13px;padding:10px 13px;cursor:pointer;white-space:nowrap}
.dock button.on{background:var(--gold);color:#17120a;font-weight:800}
.dock button:focus-visible,.ibtn:focus-visible,#card a:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
#fail{position:fixed;inset:0;display:none;align-items:center;justify-content:center;text-align:center;padding:30px;line-height:1.8}
@media (max-width:380px){.dock button{padding:9px 9px;font-size:13px}}
@media (prefers-reduced-motion: reduce){.lab,#card,.hint{transition:none}}
</style>
</head>
