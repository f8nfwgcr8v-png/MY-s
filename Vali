<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function(){
if(typeof THREE==='undefined'){document.getElementById('fail').style.display='flex';return;}

/* ---------- الأساسيات ---------- */
const stage=document.getElementById('stage');
const renderer=new THREE.WebGLRenderer({antialias:true});
const small=Math.min(innerWidth,innerHeight)<700;
renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,small?2:2));
renderer.setSize(innerWidth,innerHeight);
renderer.shadowMap.enabled=true;
renderer.shadowMap.type=THREE.PCFSoftShadowMap;
stage.appendChild(renderer.domElement);
const cv=renderer.domElement;
const scene=new THREE.Scene();
scene.fog=new THREE.Fog(0x0a0f1e,50,170);
const camera=new THREE.PerspectiveCamera(45,innerWidth/innerHeight,.1,500);
const V=(x,y,z)=>new THREE.Vector3(x,y,z);
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const world=new THREE.Group();scene.add(world);

function M(color,o){return new THREE.MeshStandardMaterial(Object.assign({color:color,roughness:.7,metalness:.05},o||{}));}
function box(p,w,h,d,m,x,y,z){const s=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),m);s.position.set(x,y,z);s.castShadow=true;s.receiveShadow=true;p.add(s);return s;}
function cyl(p,rt,rb,h,m,x,y,z,seg){const s=new THREE.Mesh(new THREE.CylinderGeometry(rt,rb,h,seg||16),m);s.position.set(x,y,z);s.castShadow=true;s.receiveShadow=true;p.add(s);return s;}
function sph(p,r,m,x,y,z){const s=new THREE.Mesh(new THREE.SphereGeometry(r,16,12),m);s.position.set(x,y,z);s.castShadow=true;p.add(s);return s;}

const W=16,D=11,H=3.6;
const wallMat=M(0x2b2724,{roughness:.85});
const gold=M(0xc9a45c,{metalness:.6,roughness:.3});
const darkWood=M(0x2c1f17,{roughness:.6});
const leather=M(0x17120f,{roughness:.5});
const cream=M(0xd9cbb2,{roughness:.8});
const lampMat=M(0xffd9a0,{emissive:0xffb35a,emissiveIntensity:1.5});
