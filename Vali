/* ---------- الكاميرا ---------- */
const PRESETS={
  outside:{mode:'orbit',target:V(0,1.9,3),r:19,th:.38,ph:1.38,fov:45},
  top:{mode:'orbit',target:V(0,.4,.5),r:25,th:0,ph:.5,fov:45},
  inside:{mode:'look',pos:V(0,1.65,4.6),th:0,ph:1.5,fov:72}
};
const cam={mode:'orbit',target:V(0,1.9,3),pos:V(0,1.65,4.6),r:19,th:.38,ph:1.38,fov:45};
const camLook=V(0,1.9,3);let view='outside',fly=null,fovGoal=45;
function dirOf(th,ph){const s=Math.sin(ph);return V(s*Math.sin(th),Math.cos(ph),s*Math.cos(th));}
function applyCam(){
  const d=dirOf(cam.th,cam.ph);
  if(cam.mode==='orbit'){camera.position.copy(cam.target).addScaledVector(d,cam.r);camLook.copy(cam.target);}
  else{camera.position.copy(cam.pos);camLook.copy(cam.pos).addScaledVector(d,-6);}
  camera.lookAt(camLook);
}
function goalOf(p){
  const c=Object.assign({},p);
  if(p.mode==='orbit'){const d=dirOf(p.th,p.ph);return {pos:p.target.clone().addScaledVector(d,p.r),look:p.target.clone()};}
  const d=dirOf(p.th,p.ph);return {pos:p.pos.clone(),look:p.pos.clone().addScaledVector(d,-6)};
}
function adopt(name){
  const p=PRESETS[name];cam.mode=p.mode;cam.th=p.th;cam.ph=p.ph;fovGoal=p.fov;
  if(p.mode==='orbit'){cam.target.copy(p.target);cam.r=p.r;}else{cam.pos.copy(p.pos);}
  setView(name);
}
function isInside(v){return Math.abs(v.x)<7.9&&Math.abs(v.z)<5.4&&v.y<3.6;}
function capture(){
  const pos=camera.position.clone();
  if(isInside(pos)){const d=camLook.clone().sub(pos).normalize().negate();cam.mode='look';cam.pos.copy(pos);cam.ph=Math.acos(clamp(d.y,-1,1));cam.th=Math.atan2(d.x,d.z);fovGoal=72;}
  else{const tg=camLook.clone();const d=pos.clone().sub(tg);cam.mode='orbit';cam.target.copy(tg);cam.r=clamp(d.length(),8,38);d.normalize();cam.ph=Math.acos(clamp(d.y,-1,1));cam.th=Math.atan2(d.x,d.z);fovGoal=45;}
}
function cancelFly(){if(fly){fly=null;capture();setView('free');}}
function flyTo(P,L,dur,preset,ease){fly={pc:new THREE.CatmullRomCurve3(P),lc:new THREE.CatmullRomCurve3(L),t:0,d:dur,preset:preset,ease:ease||0};}
function goView(name){
  hintShow();
  const g=goalOf(PRESETS[name]);const here=camera.position.clone();
  const P=[here],L=[camLook.clone()];
  const wasIn=isInside(here),toIn=name==='inside';
  if(wasIn!==toIn){
    if(toIn){P.push(V(0,1.9,9.5));L.push(V(0,1.8,2));P.push(V(0,1.7,6.6));L.push(V(0,1.5,0));}
    else{P.push(V(0,1.7,6.6));L.push(V(0,1.6,9));P.push(V(0,2.2,10));L.push(V(0,1.8,5));}
  }
  P.push(g.pos);L.push(g.look);
  fovGoal=PRESETS[name].fov;
  flyTo(P,L,wasIn!==toIn?4.6:3,name,0);
  setView(name);
}
function startTour(){
  hintShow();fovGoal=45;
  const P=[camera.position.clone(),V(-9,3,16),V(-2,2,11),V(0,1.75,6.5),V(0,1.65,4.4),V(-.5,1.65,2.2),V(1,1.65,1),V(0,8.5,6.5)];
  const L=[camLook.clone(),V(0,2.6,5.5),V(0,2.8,5.5),V(0,1.5,3),V(-5,1.2,3.4),V(0,1.5,-5),V(5,1.3,3.5),V(0,.5,0)];
  const g=goalOf(PRESETS.top);P.push(g.pos);L.push(g.look);
  flyTo(P,L,30,'top',.65);setView('tour');
}
function setView(v){view=v;document.querySelectorAll('.dock [data-v]').forEach(function(b){b.classList.toggle('on',b.dataset.v===v);});hintText();}

/* ---------- التحكم باللمس والماوس ---------- */
const ptrs=new Map();let lastD=0;
function pdist(){const a=Array.from(ptrs.values());return Math.hypot(a[0].x-a[1].x,a[0].y-a[1].y);}
function walk(a){
  const f=V(-Math.sin(cam.th),0,-Math.cos(cam.th));cam.pos.addScaledVector(f,a);
  cam.pos.x=clamp(cam.pos.x,-7,7);cam.pos.z=clamp(cam.pos.z,-4.2,5.0);
}
function zoom(amt,fromPinch){
  if(cam.mode==='orbit'){cam.r=clamp(cam.r+amt,8,38);}
  else{walk(-amt*.05);}
}
cv.addEventListener('pointerdown',function(e){cv.setPointerCapture(e.pointerId);ptrs.set(e.pointerId,{x:e.clientX,y:e.clientY});cancelFly();hintHide();if(ptrs.size===2)lastD=pdist();});
cv.addEventListener('pointermove',function(e){
  const p=ptrs.get(e.pointerId);if(!p)return;
  const dx=e.clientX-p.x,dy=e.clientY-p.y;p.x=e.clientX;p.y=e.clientY;
  if(ptrs.size===1){
    cam.th-=dx*.006;
    cam.ph+=(cam.mode==='orbit'?-1:1)*dy*.005;
    cam.ph=cam.mode==='orbit'?clamp(cam.ph,.12,1.5):clamp(cam.ph,.9,2.3);
  }else if(ptrs.size===2){const d=pdist();zoom((lastD-d)*.06,true);lastD=d;}
});
function up(e){ptrs.delete(e.pointerId);if(ptrs.size<2)lastD=0;}
cv.addEventListener('pointerup',up);cv.addEventListener('pointercancel',up);
