/* ---------- الحلقة ---------- */
const clock=new THREE.Clock();let roofOp=1;
function frame(){
  requestAnimationFrame(frame);
  const dt=Math.min(clock.getDelta(),.05),t=clock.elapsedTime;
  // الكاميرا
  if(fly){
    fly.t+=dt;const u=Math.min(fly.t/fly.d,1);const s=u*u*(3-2*u);const e=u*(1-fly.ease)+s*fly.ease;
    camera.position.copy(fly.pc.getPoint(e));camLook.copy(fly.lc.getPoint(e));camera.lookAt(camLook);
    if(u>=1){const p=fly.preset;fly=null;adopt(p);}
  }else applyCam();
  if(Math.abs(camera.fov-fovGoal)>.05){camera.fov+=(fovGoal-camera.fov)*Math.min(1,dt*3);camera.updateProjectionMatrix();}
  // السقف
  const hideRoof=camera.position.y>7||(fly&&fly.preset==='top'&&fly.t/fly.d>.88);
  const goal=hideRoof?0:1;roofOp+=(goal-roofOp)*Math.min(1,dt*4);
  roofMat.opacity=roofOp;roofGroup.visible=roofOp>.03;roofSlab.castShadow=roofOp>.5;
  pendants.visible=roofOp>.45;
  // الليل والنهار
  if(Math.abs(night-nightGoal)>.002){night+=(nightGoal-night)*Math.min(1,dt*2.5);applyEnv(night);}
  // حركة
  cars.forEach(function(c){c.g.position.x+=c.dir*c.speed*dt;if(c.g.position.x>60)c.g.position.x=-60;if(c.g.position.x<-60)c.g.position.x=60;});
  chairs.forEach(function(c,i){c.rotation.y=Math.sin(t*.45+i*1.7)*.22;});
  barbers.forEach(function(o){const a=Math.sin(t*3.2+o.ph);o.b.aR.rotation.x=-1.25+a*.22;o.b.aR.rotation.z=-.1+Math.sin(t*1.6+o.ph)*.12;o.b.aL.rotation.x=-.7+Math.sin(t*2.1+o.ph)*.1;o.b.g.position.x+=0;});
  openMat.opacity=.82+.18*Math.sin(t*2.4);
  updateLabels(roofOp<.5||(cam.mode==='look'&&!fly)||(fly&&camera.position.y<3.6&&isInside(camera.position)));
  renderer.render(scene,camera);
}
addEventListener('resize',function(){camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);});
