const glassMat=new THREE.MeshStandardMaterial({color:0x8fb4cf,transparent:true,opacity:.16,roughness:.05,metalness:.3,side:THREE.DoubleSide,depthWrite:false});
const winMat=M(0x1d2026,{emissive:0xffc778,emissiveIntensity:0});

/* ---------- نصوص على لوحات (Canvas) ---------- */
const texList=[];
function textTex(w,h,draw){
  const c=document.createElement('canvas');c.width=w;c.height=h;const g=c.getContext('2d');
  const t=new THREE.CanvasTexture(c);t.anisotropy=8;
  const o={t:t,redraw:function(){g.clearRect(0,0,w,h);draw(g,w,h);t.needsUpdate=true;}};
  o.redraw();texList.push(o);return o;
}
const SERIF='"Playfair Display",Georgia,"Times New Roman",serif';
const SANS='"Tajawal","Segoe UI",Tahoma,Arial,sans-serif';
function goldGrad(g,x0,x1){const gr=g.createLinearGradient(x0,0,x1,0);gr.addColorStop(0,'#e9cf8f');gr.addColorStop(.5,'#c9a45c');gr.addColorStop(1,'#a37f3a');return gr;}
const signTex=textTex(2000,200,function(g,w,h){
  const bg=g.createLinearGradient(0,0,0,h);bg.addColorStop(0,'#1b1815');bg.addColorStop(1,'#0e0c0a');
  g.fillStyle=bg;g.fillRect(0,0,w,h);
  g.strokeStyle='#c9a45c';g.lineWidth=5;g.strokeRect(10,10,w-20,h-20);
  g.lineWidth=1.5;g.strokeRect(22,22,w-44,h-44);
  g.textBaseline='middle';g.textAlign='center';
  g.fillStyle=goldGrad(g,300,900);g.font='700 128px '+SERIF;g.fillText('VALi',640,104);
  g.fillStyle='#c9a45c';g.fillRect(1010,46,3,108);
  g.direction='rtl';g.fillStyle='#efe6d6';g.font='800 70px '+SANS;g.fillText('للعناية بالرجل',1420,86);
  g.direction='ltr';g.fillStyle='#c9a45c';g.font='500 30px '+SANS;g.fillText('M E N ’ S   G R O O M I N G',1420,148);
});
const logoTex=textTex(512,256,function(g,w,h){
  g.fillStyle='rgba(0,0,0,0)';g.fillRect(0,0,w,h);g.textAlign='center';g.textBaseline='middle';
  g.fillStyle=goldGrad(g,120,400);g.font='700 120px '+SERIF;g.fillText('VALi',256,110);
  g.direction='rtl';g.fillStyle='#efe6d6';g.font='500 34px '+SANS;g.fillText('للعناية بالرجل',256,200);
});
const openTex=textTex(512,200,function(g,w,h){
  g.clearRect(0,0,w,h);g.textAlign='center';g.textBaseline='middle';
  g.strokeStyle='#ffd27a';g.lineWidth=6;g.strokeRect(8,8,w-16,h-16);
  g.shadowColor='#ffb347';g.shadowBlur=18;g.fillStyle='#ffe2a6';
  g.direction='rtl';g.font='800 84px '+SANS;g.fillText('مفتوح',256,84);
  g.direction='ltr';g.font='500 36px '+SANS;g.fillText('O P E N',256,152);
});
if(document.fonts&&document.fonts.load){
  Promise.all([document.fonts.load('700 100px "Playfair Display"'),document.fonts.load('800 60px "Tajawal"'),document.fonts.load('500 30px "Tajawal"')])
   .then(function(){texList.forEach(function(o){o.redraw();});}).catch(function(){});
}
const signMat=new THREE.MeshBasicMaterial({map:signTex.t});
const logoMat=new THREE.MeshBasicMaterial({map:logoTex.t,transparent:true});
const openMat=new THREE.MeshBasicMaterial({map:openTex.t,transparent:true});

function glowTex(){const c=document.createElement('canvas');c.width=c.height=128;const g=c.getContext('2d');
  const r=g.createRadialGradient(64,64,0,64,64,64);r.addColorStop(0,'rgba(255,214,150,1)');r.addColorStop(.35,'rgba(255,180,90,.35)');r.addColorStop(1,'rgba(255,170,80,0)');
  g.fillStyle=r;g.fillRect(0,0,128,128);return new THREE.CanvasTexture(c);}
const gTex=glowTex();const glows=[];
function glow(p,x,y,z,s){const m=new THREE.SpriteMaterial({map:gTex,transparent:true,blending:THREE.AdditiveBlending,depthWrite:false,fog:false});
  const sp=new THREE.Sprite(m);sp.position.set(x,y,z);sp.scale.set(s,s,1);p.add(sp);glows.push(m);return sp;}

/* ---------- الإضاءة ---------- */
const ambient=new THREE.AmbientLight(0xffffff,.4);scene.add(ambient);
const hemi=new THREE.HemisphereLight(0xcfe0ff,0x2a2118,.5);scene.add(hemi);
const sun=new THREE.DirectionalLight(0xffffff,.8);
sun.position.set(18,32,24);sun.castShadow=true;
sun.shadow.mapSize.set(small?1024:2048,small?1024:2048);
Object.assign(sun.shadow.camera,{left:-34,right:34,top:34,bottom:-34,near:1,far:110});
sun.shadow.bias=-.0006;scene.add(sun);
const pts=[V(-4.5,3,2),V(4.5,3,1),V(0,3,-3.2)].map(function(v){const l=new THREE.PointLight(0xffc98a,1,14,1.6);l.position.copy(v);scene.add(l);return l;});

/* ---------- الشارع والمحيط ---------- */
box(world,220,.2,220,M(0x1d1f22,{roughness:.95}),0,-.1,0);
box(world,90,.16,3.2,M(0x8c8780,{roughness:.9}),0,0,7.2);
box(world,90,.2,.25,M(0xb7b1a6),0,0,8.9);
const road=new THREE.Mesh(new THREE.PlaneGeometry(220,10),M(0x26272b,{roughness:.9}));
road.rotation.x=-Math.PI/2;road.position.set(0,.011,13.8);road.receiveShadow=true;world.add(road);
for(let x=-84;x<=84;x+=6)box(world,2.6,.012,.14,M(0xd8d3c4),x,.02,13.8);
// أرضية ما خلف المبنى
box(world,90,.05,30,M(0x2a2b2e,{roughness:.95}),0,.0,-18);

let seed=7;function rnd(){seed=(seed*16807)%2147483647;return seed/2147483647;}
[-1,1].forEach(function(s){
  box(world,12,5.4,D,M(0x3b3732,{roughness:.9}),s*14,2.7,0);
  box(world,10,2.2,.12,M(0x24221f),s*14,1.1,5.56);
  for(let i=0;i<3;i++)box(world,2.4,1.4,.1,winMat,s*14+(i-1)*3.6,3.9,5.57);
});
for(let i=0;i<16;i++){
  const x=-70+i*9+rnd()*3,h=7+rnd()*16;
  box(world,6+rnd()*3,h,7,M(0x23262b,{roughness:.9}),x,h/2,-26-rnd()*8);
}
for(let i=0;i<10;i++){
  const x=-60+i*13+rnd()*4,h=5+rnd()*9;
  box(world,7,h,7,M(0x2b2d33,{roughness:.9}),x,h/2,34+rnd()*6);
}

/* ---------- المبنى ---------- */
// الجدران
box(world,W,H,.3,wallMat,0,H/2,-5.5);
box(world,.3,H,D,wallMat,-8,H/2,0);
box(world,.3,H,D,wallMat,8,H/2,0);
box(world,2,2.6,.3,wallMat,-7,1.3,5.5);
box(world,2,2.6,.3,wallMat,7,1.3,5.5);
box(world,W,1.0,.3,wallMat,0,3.1,5.5);
// حواف ذهبية أعلى الجدران
box(world,W+.3,.08,.2,gold,0,H+.04,5.5);box(world,W+.3,.08,.2,gold,0,H+.04,-5.5);
box(world,.2,.08,D,gold,-8,H+.04,0);box(world,.2,.08,D,gold,8,H+.04,0);
// الزجاج والإطارات
box(world,5,2.55,.04,glassMat,-3.5,1.3,5.5).castShadow=false;
box(world,5,2.55,.04,glassMat,3.5,1.3,5.5).castShadow=false;
box(world,2,2.55,.04,glassMat,0,1.3,5.5).castShadow=false;
[-6,-1,1,6].forEach(function(x){box(world,.07,2.6,.34,gold,x,1.3,5.5);});
box(world,12,.06,.34,gold,0,2.58,5.5);
box(world,12,.06,.34,gold,0,.05,5.5);
box(world,12,.05,.34,gold,0,1.0,5.5);
[-.18,.18].forEach(function(x){cyl(world,.025,.025,.8,gold,x,1.15,5.7,8);});
box(world,.9,.3,.04,gold,-.48,.2,5.56);box(world,.9,.3,.04,gold,.48,.2,5.56);
// اللوحة
box(world,9.6,1.04,.2,M(0x0f0d0b),0,3.12,5.74);
const sign=new THREE.Mesh(new THREE.PlaneGeometry(9.4,.94),signMat);sign.position.set(0,3.12,5.85);world.add(sign);
glow(world,0,3.12,6.2,12);
[-3.2,0,3.2].forEach(function(x){box(world,.9,.04,.12,lampMat,x,2.56,5.8);});
// لافتة مفتوح
const openP=new THREE.Mesh(new THREE.PlaneGeometry(1.5,.6),openMat);openP.position.set(-3.6,1.7,5.46);world.add(openP);
glow(world,-3.6,1.7,5.9,2.6);
// مدخل
box(world,2.8,.02,1.3,M(0x1a1714,{roughness:.9}),0,.1,6.3);
box(world,2.8,.025,.06,gold,0,.11,5.68);
// أرضية الداخل
const floorTex=(function(){const c=document.createElement('canvas');c.width=c.height=512;const g=c.getContext('2d');
  for(let i=0;i<8;i++){g.fillStyle='hsl(26,'+(30+(i%3)*4)+'%,'+(15+((i*7)%5))+'%)';g.fillRect(0,i*64,512,64);g.fillStyle='rgba(0,0,0,.4)';g.fillRect(0,i*64,512,2);}
  for(let k=0;k<30;k++){g.fillStyle='rgba(0,0,0,.35)';g.fillRect((k*97)%512,Math.floor((k*5.3)%8)*64,2,64);}
  const t=new THREE.CanvasTexture(c);t.wrapS=t.wrapT=THREE.RepeatWrapping;t.repeat.set(4,3);t.anisotropy=4;return t;})();
const floor=new THREE.Mesh(new THREE.PlaneGeometry(W-.3,D-.3),new THREE.MeshStandardMaterial({map:floorTex,roughness:.45,metalness:.1}));
floor.rotation.x=-Math.PI/2;floor.position.y=.06;floor.receiveShadow=true;world.add(floor);
// قوائم جدار الخلف
for(let i=0;i<9;i++)box(world,.05,H-.4,.04,gold,-7+i*1.75,H/2,-5.34);

/* ---------- السقف (يختفي في العرض من فوق) ---------- */
const roofMat=M(0x1f1c19,{roughness:.9});roofMat.transparent=true;
const roofGroup=new THREE.Group();world.add(roofGroup);
const roofSlab=box(roofGroup,W-.2,.2,D-.2,roofMat,0,H+.1,0);
const pendants=new THREE.Group();world.add(pendants);
[-.4,.4].forEach(function(){});
[-4,0,4].forEach(function(x){box(pendants,.08,.03,9.6,lampMat,x,H-.03,0);});
function pendant(x,y,z){cyl(pendants,.01,.01,H-y,gold,x,(H+y)/2,z,6);const s=cyl(pendants,.08,.3,.26,lampMat,x,y,z,20);}
[-5.25,-1.75,1.75,5.25].forEach(function(x){pendant(x,2.7,-3.3);});
pendant(-5.4,2.7,3.4);pendant(-6.6,2.7,1.7);pendant(5,2.7,3.0);

/* ---------- الأثاث والناس ---------- */
const anim=[];
function person(parent,o){
  const g=new THREE.Group();g.position.set(o.x,o.y||0,o.z);g.rotation.y=o.rot||0;parent.add(g);
  const skin=M(o.skin||0xd2a07a),shirt=M(o.shirt||0x222222),pants=M(0x15151a),hair=M(o.hair||0x1a1410);
  const seated=!!o.seated;const tY=seated?1.08:1.16;
  if(!seated){cyl(g,.09,.08,.85,pants,-.11,.43,0,10);cyl(g,.09,.08,.85,pants,.11,.43,0,10);}
  else{box(g,.17,.16,.5,pants,-.11,.78,.2);box(g,.17,.16,.5,pants,.11,.78,.2);cyl(g,.07,.06,.55,pants,-.11,.45,.42,8);cyl(g,.07,.06,.55,pants,.11,.45,.42,8);}
  box(g,.46,.62,.26,shirt,0,tY,0);
