  }
}
:root[data-theme="light"]{
  --bg:#e9e2d4; --ink:#241d14; --ink2:#5b4d38; --gold:#8c6a22;
  --panel:rgba(250,246,238,.86); --line:rgba(140,106,34,.45); --btn:rgba(0,0,0,.05);
}
:root[data-theme="dark"]{
  --bg:#14110f; --ink:#f4ede1; --ink2:#cdbfa6; --gold:#c9a45c;
